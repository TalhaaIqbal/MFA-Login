# Application Configuration
APP_NAME=Scraper Dashboard

# Environment Configuration
# Set to 'local' for development, 'production' for production
ENVIRONMENT=local

# MongoDB Configuration
DB_USER=your_mongodb_username
DB_PASSWORD=your_mongodb_password
DB_HOST=your_mongodb_host
DB_NAME=Scraper

# Slack Configuration (Optional)
SLACK_WEBHOOK_URL=

# Encryption Configuration
ENCRYPTION_KEY=your_44_byte_base64_fernet_key_here

# OAuth Configuration
# Google Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTHORIZED_REDIRECT_URI=

# Github Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_AUTHORIZED_REDIRECT_URI=

# Microsoft Credentials
MICROSOFT_CLIENT_ID=
MICORSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_AUTHORIZED_REDIRECT_URI=

# Cookie Configuration
# Automatically configured based on ENVIRONMENT
# Local: secure=false, samesite=lax, partitioned=false
# Production: secure=true, samesite=none, partitioned=true
# You can override these with explicit COOKIE_* variables if needed

# CORS Configuration for Local Development
# Add your frontend URL here (e.g., http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin User Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# API Documentation
ENABLE_DOCS=true
